# Discord
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
# Forum channel where people post bug reports
DISCORD_WATCHED_CHANNEL_ID=
# Private channel for the audit log and sync errors (optional)
DISCORD_LOG_CHANNEL_ID=
# Role IDs, comma separated. Triagers acknowledge, categorise, prioritise and sync.
DISCORD_TRIAGER_ROLE_IDS=
# Maintainers can also link/unlink existing issues and override any state.
DISCORD_MAINTAINER_ROLE_IDS=

# GitHub App (installed on the private repo with Issues: read/write, Metadata: read)
GITHUB_APP_ID=
# PEM contents; literal "\n" sequences are converted to newlines
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_REPO=owner/name
GITHUB_WEBHOOK_SECRET=

# Behaviour
# public | triagers | none: who sees the GitHub issue link in Discord
ISSUE_LINK_VISIBILITY=triagers
# GitHub comments starting with this marker are never relayed to Discord
INTERNAL_COMMENT_MARKER=[internal]
# Days before a "needs info" post with no reply from the reporter is closed
NEEDS_INFO_TIMEOUT_DAYS=14

# Runtime
DATABASE_PATH=./data/sync.db
PORT=3000
LOG_LEVEL=info
