{
  "name": "forge-discord-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Discord forum <> GitHub issues sync with a triage gate",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "register-commands": "tsx src/discord/register.ts"
  },
  "dependencies": {
    "@octokit/app": "^16.1.4",
    "discord.js": "^14.27.0",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
